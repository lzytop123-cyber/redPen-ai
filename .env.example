# === 文本批改大模型配置（兼容 OpenAI 协议：DeepSeek / 通义千问 / 豆包 / OpenAI / Gemini）===
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat

# === 视觉 OCR 大模型配置（用于识别手写答卷照片，可选；不填则默认复用上方配置）===
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=sk-your-vlm-api-key-here
VLM_MODEL=qwen-vl-max

# === 模型参数 ===
LLM_TEMPERATURE=0.15
LLM_TIMEOUT_SECONDS=60

# === 数据库配置 ===
# 生产环境（启动 docker-compose up -d 后使用 PostgreSQL）：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_grading
# 本地零依赖快速启动（默认使用 SQLite，无需装 Docker 即可跑通完整 API）：
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# === Redis 配置（后续接入 ARQ 分布式队列用）===
REDIS_URL=redis://localhost:6379/0

# === 微信小程序配置（上线时填入真实 AppID / Secret）===
WX_APPID=
WX_SECRET=
JWT_SECRET=change-me-in-production-secret-key
ADMIN_PASSWORD=change-me-strong-admin-password

# === 开发调试选项 ===
# 为 true 且未配置 LLM_API_KEY 时自动走 Mock 精批，方便前后端零费用联调
ENABLE_MOCK_FALLBACK=true
