# 复制为服务器上的 /opt/zxd-ai/.env 后，替换每一个 __SET_ON_SERVER__。
# 这是 systemd EnvironmentFile：不要写 export，不要在等号两侧加空格，不要提交填好的文件。
# 未替换占位符时，生产进程会拒绝启动，或者精批/微信登录保持关闭。

APP_ENV=production
DATABASE_URL=sqlite+aiosqlite:////opt/zxd-ai/data/zxd-ai.db
JWT_SECRET=__SET_ON_SERVER__
ADMIN_PASSWORD=__SET_ON_SERVER__
ENABLE_MOCK_FALLBACK=false

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=__SET_ON_SERVER__
LLM_MODEL=deepseek-chat
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=qwen-vl-max
LLM_TEMPERATURE=0.15
LLM_TIMEOUT_SECONDS=60

WX_APPID=
WX_SECRET=
CORS_ORIGINS=
REDIS_URL=
