# === 1. 你的正式域名（已解析 A 记录到服务器公网 IP，Caddy 会自动申请免费 HTTPS 证书）===
DOMAIN=你的域名.com

# === 2. DeepSeek 文本精批 + 视觉 OCR（共用同一个 Key）===
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-替换为你真实的DeepSeek密钥
LLM_MODEL=deepseek-chat

VLM_BASE_URL=https://api.deepseek.com/v1
VLM_API_KEY=
VLM_MODEL=deepseek-flash

LLM_TEMPERATURE=0.15
LLM_TIMEOUT_SECONDS=60

# === 3. 数据库（默认复用 data/app.db 保留全部 1191 道真题，已开启 WAL 并发模式）===
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# === 4. 生产安全配置（上线前务必替换为随机强密码）===
JWT_SECRET=请替换为至少32位随机字符串
ADMIN_PASSWORD=请替换为强管理员密码
ENABLE_MOCK_FALLBACK=false
